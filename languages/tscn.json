          "id": "script",
          "label": "Script",
          "type": "text",
          "default": ""
        },
        {
          "id": "method",
          "label": "Método",
          "type": "text",
          "default": ""
        }
      ],
      "inputs": [
        {
          "id": "in",
          "kind": "signal",
          "label": "sinal"
        }
      ],
      "outputs": [],
      "code": ".connect({method})",
      "description": "Aponta para um método de um script do projeto. Ligue a saída de um sinal de um nó de cena aqui para documentar a conexão (sinal → método). Crie arrastando um .gd para o vazio da cena ou pela busca."
    },
